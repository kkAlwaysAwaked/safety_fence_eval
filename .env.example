# Copy to .env and fill in your keys. Do not commit .env.

# Safety Fence driver (OpenAI-compatible, e.g. Qwen via DashScope)
FENCE_API_KEY=
FENCE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
FENCE_MODEL=qwen3.5-flash

# Cloud model used for e2e + optional LLM-as-Judge
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

FENCE_TIMEOUT=60
CLOUD_TIMEOUT=60
CONCURRENCY=30
